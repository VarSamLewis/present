# Storage
DATABASE_PATH=./data/vibeslide.db
DATA_DIRECTORY=./data

# Authentication (Clerk) — optional.
# Leave unset to run without a login gate (fine for local use).
# To require sign-in, create an application at https://dashboard.clerk.com and set:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY   publishable key (pk_...)
#   CLERK_SECRET_KEY                    secret key (sk_...)
# Sign-in and sign-up are served at /sign-in and /sign-up. Keys are read at
# runtime, so the same image works in any environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# All AI settings (key, base URL, model) are configured in the app's Settings
# page at /settings and stored in the local database. Everything below is an
# optional fallback / tuning — you can run with no .env.local at all.

# Fallback embedding model (uses the same API key and base URL as generation)
EMBEDDING_MODEL=text-embedding-3-small

# Optional fallbacks if nothing is saved in Settings
AI_GENERATION_MODEL=gpt-4o

# Pipeline tuning
MAX_SOURCE_CHUNKS_PER_SLIDE=8
MAX_SLIDE_REPAIR_ATTEMPTS=2
SLIDE_GENERATION_CONCURRENCY=2
