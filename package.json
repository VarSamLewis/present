    "marked": "^16.0.0",
    "next": "16.2.10",
    "openai": "^4.90.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.52.0",
    "postcss": "^8.5.0",
    "postcss-safe-parser": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^3.4.17",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
